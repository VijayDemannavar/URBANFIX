{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "db/**/*.ts",
    "server/**/*.ts",
    "netlify/functions/**/*.ts",
    "netlify/functions/**/*.mts",
    "tests/netlify/**/*.ts",
    "drizzle.config.ts"
  ]
}
