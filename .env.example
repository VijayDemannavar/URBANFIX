# CivicAI Environment Variables – copy to .env and fill in values
# Never commit the real .env file to version control.

# Flask secret key (change this in production)
CIVICAI_SECRET_KEY=your-very-secret-key-here

# Set to "false" in production
CIVICAI_DEBUG=true

# Server bind address
CIVICAI_HOST=127.0.0.1
CIVICAI_PORT=5000

# Admin authentication mode: "session" (recommended), "password", "open", "disabled"
CIVICAI_ADMIN_AUTH_MODE=session

# Admin credentials
CIVICAI_ADMIN_USERNAME=admin
CIVICAI_ADMIN_PASSWORD=your-secure-admin-password-here
